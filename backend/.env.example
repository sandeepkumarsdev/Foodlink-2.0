# Database Connection (Supabase PostgreSQL)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooler)
POSTGRES_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase API & Auth Configuration
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Gemini AI Key
GEMINI_API_KEY="your-gemini-api-key"

# Express Port
PORT=3000
