# Database Connection (Supabase PostgreSQL)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooler)
POSTGRES_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase API & Auth Configuration
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Gemini AI Key
GEMINI_API_KEY="your-gemini-api-key"

# Express Port
PORT=3000

# Email Verification (Gmail SMTP - No custom domain required!)
# 1. Use your Gmail address: EMAIL_USER="yourname@gmail.com"
# 2. Generate a 16-char App Password at https://myaccount.google.com/apppasswords
# 3. Set EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_USER=""
EMAIL_PASS=""

# Optional Custom SMTP Server (if not using standard Gmail)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE="false"
