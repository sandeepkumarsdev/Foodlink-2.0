{
  "name": "foodlink",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=foodlink-frontend",
    "dev:backend": "npm run dev --workspace=foodlink-backend",
    "build:api": "node scripts/build-api.js",
    "build": "npm run build --workspace=foodlink-frontend && node scripts/copy-dist.js && node scripts/build-api.js",
    "install:all": "npm install"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2"
  }
}
